{
  "name": "flea-market-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "dev:api": "pnpm --filter @flea-market/api start:dev",
    "dev:web": "pnpm --filter @flea-market/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --filter @flea-market/api test:e2e",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.0"
  }
}
